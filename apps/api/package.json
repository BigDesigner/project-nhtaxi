{
  "name": "@gnncab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gnncab --local",
    "db:migrate:remote": "wrangler d1 migrations apply gnncab --remote",
    "deploy": "wrangler deploy",
    "seed:admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@gnncab/contract": "workspace:*",
    "@gnncab/db": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
