# Local dev secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# Production/staging secrets are never stored in a file — see README.md
# "Cloudflare secrets" section (wrangler secret put, from GitHub Secrets in CI).

JWT_SECRET=change-me-local-dev-only
ENVIRONMENT=development
# Base64-encoded 256-bit AES-GCM key wrapping driver document data keys (L19).
# Generate a real one with:
#   node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=UsctM0ECivyhbOIrSbW87y+ARKw6OsyJIAlphgbfq4c=
