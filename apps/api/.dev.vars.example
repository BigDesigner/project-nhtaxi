# Local dev secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# Production/staging secrets are never stored in a file — see README.md
# "Cloudflare secrets" section (wrangler secret put, from GitHub Secrets in CI).

JWT_SECRET=change-me-local-dev-only
ENVIRONMENT=development
# Base64-encoded 256-bit AES-GCM key wrapping driver document data keys (L19).
# Generate your own — never reuse this or any other committed example value:
#   node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=change-me-generate-your-own-local-dev-only
# One-time, self-locking POST /api/admin/bootstrap (creates the first admin
# while none exist) requires this in an X-Bootstrap-Token header. Any random
# string works — generate one the same way as DOCUMENT_ENCRYPTION_KEY above.
ADMIN_BOOTSTRAP_TOKEN=change-me-generate-your-own-local-dev-only
